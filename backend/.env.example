# Application
APP_NAME="Enterprise Knowledge Management Platform"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql+psycopg://ekp:ekp_secret@localhost:5432/ekp

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth (used in Phase 2+)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting (Phase 7)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=40

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/uploads
UPLOAD_MAX_SIZE_MB=25
# When STORAGE_BACKEND=azure (requires: pip install -e ".[azure]")
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# Optional Application Insights connection string (stdout JSON is the primary log path)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Embeddings — default fake so local boot works without API keys.
# Set EMBEDDING_PROVIDER=together + TOGETHER_API_KEY for real RAG.
# Re-ingest documents after switching providers (vectors are provider-specific).
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# LLM / Together.ai — set LLM_PROVIDER=together for real completions.
LLM_PROVIDER=fake
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
TOGETHER_BASE_URL=https://api.together.xyz/v1
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# RAG retrieval thresholds (calibrate per embedding model — score ranges differ)
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.50
RAG_MIN_SUPPORTING_CHUNKS=1
RAG_MIN_TERM_OVERLAP=1
RAG_ANSWER_STYLE=concise
# Legacy aliases still accepted: RETRIEVAL_TOP_K, RETRIEVAL_MIN_SCORE
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Ingestion (BackgroundTasks); stale jobs are failed on startup / admin recover
INGESTION_STALE_JOB_MINUTES=30
